[Unit]
Description=VisionOps Modbus RTU Master Push Service
After=network-online.target visionops-inference-cpp.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/visionops/edge/robot_gateway/modbus_rtu_master
EnvironmentFile=/opt/visionops/edge/robot_gateway/modbus_rtu_master/modbus_rtu_master.env
ExecStart=/opt/visionops/venv/bin/python /opt/visionops/edge/robot_gateway/modbus_rtu_master/modbus_rtu_master_push.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
