# VisionOps Modbus RTU Master Push v1.3
# 适用场景：
# - PLC 作为 Modbus RTU Slave
# - 3576 作为 Modbus RTU Master
# - 3576 周期性把 VisionOps register_map_v2 写入 PLC 的 Holding Registers

VISIONOPS_MODBUS_MASTER_ENABLE=1

# 3576 盒子上的 RS-485 串口设备
VISIONOPS_MODBUS_SERIAL=/dev/ttyS5

# PLC 从站地址
VISIONOPS_MODBUS_TARGET_SLAVE_ID=1

# Modbus RTU 串口参数，需要与 PLC 保持一致
VISIONOPS_MODBUS_BAUDRATE=9600
VISIONOPS_MODBUS_PARITY=N
VISIONOPS_MODBUS_BYTESIZE=8
VISIONOPS_MODBUS_STOPBITS=1

# PLC 目标起始协议地址。
# 例如 mbpoll -r 4097 对应协议地址 4096；
# PLC 表里 404097 通常也对应协议地址 4096。
VISIONOPS_MODBUS_TARGET_ADDRESS=4096

# 从 VisionOps 内部 register_map_v2 的哪个位置开始写
VISIONOPS_MODBUS_SOURCE_START=0

# 写入 PLC 的寄存器数量。
# FC16 单帧最多常用 123 个寄存器；如果大于 123，本服务会自动分包写入。
VISIONOPS_MODBUS_WRITE_COUNT=120
VISIONOPS_MODBUS_WRITE_CHUNK_SIZE=120

# 多久把最新检测结果写入 PLC 一次
VISIONOPS_MODBUS_PUSH_INTERVAL_MS=100

# 是否只在寄存器内容变化时写入。
# 0：每个周期都写；1：只有内容变化才写。
VISIONOPS_MODBUS_WRITE_ONLY_ON_CHANGE=0

# 读取 VisionOps 最新检测结果的接口
VISIONOPS_RESULT_URL=http://127.0.0.1:8090/api/cpp/stream/latest_result

# VisionOps register_map_v2 生成参数
VISIONOPS_MODBUS_REGISTER_COUNT=300
VISIONOPS_MODBUS_MAX_OBJECTS=5

# NG 判定逻辑：
# 留空：默认有结果即 NG；
# 指定类别：例如 1,2,3 表示检测到 class_id 为 1/2/3 时 ng_flag=1。
VISIONOPS_MODBUS_NG_CLASS_IDS=

# LPR3576 / LB3576 RS485 半双工方向控制
VISIONOPS_MODBUS_GPIO_ENABLE=1
VISIONOPS_MODBUS_GPIO_NUM=136
VISIONOPS_MODBUS_GPIO_TX_VALUE=1
VISIONOPS_MODBUS_GPIO_RX_VALUE=0
VISIONOPS_MODBUS_TX_PRE_DELAY_MS=2
VISIONOPS_MODBUS_TX_POST_DELAY_MS=5

# 等待 PLC 写入确认响应的超时时间
VISIONOPS_MODBUS_RESPONSE_TIMEOUT_MS=500

# 日志级别
VISIONOPS_MODBUS_LOG_LEVEL=INFO
