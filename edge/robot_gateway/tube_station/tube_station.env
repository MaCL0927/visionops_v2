# VisionOps Tube Station Modbus TCP Service
# 任务：上位机写触发寄存器 -> HP60C 拍一张图 -> C++ 单图推理 -> 写回左右纸筒状态

VISIONOPS_TUBE_ENABLE=1
VISIONOPS_TUBE_MODBUS_HOST=0.0.0.0
VISIONOPS_TUBE_MODBUS_PORT=1502
VISIONOPS_TUBE_MODBUS_UNIT_ID=1
VISIONOPS_TUBE_ADDRESS_BASE=0
VISIONOPS_TUBE_REGISTER_COUNT=64

# infer_once: 抓取 HP60C bridge snapshot 后调用 C++ 单图推理接口 /api/cpp/infer
# latest_result: 只读取现有实时检测最新结果，适合临时联调
VISIONOPS_TUBE_RESULT_MODE=infer_once
VISIONOPS_TUBE_SNAPSHOT_URL=http://127.0.0.1:18181/stream/snapshot.jpg
VISIONOPS_TUBE_INFER_URL=http://127.0.0.1:8090/api/cpp/infer
VISIONOPS_TUBE_LATEST_RESULT_URL=http://127.0.0.1:8090/api/cpp/stream/latest_result

# 模型类别映射：stand=0, lying=1
VISIONOPS_TUBE_STAND_CLASS_IDS=0
VISIONOPS_TUBE_LYING_CLASS_IDS=1
VISIONOPS_TUBE_MIN_CONF=0.30

# 超时参数
VISIONOPS_TUBE_SNAPSHOT_TIMEOUT_MS=1500
VISIONOPS_TUBE_INFER_TIMEOUT_MS=5000
VISIONOPS_TUBE_TRIGGER_TIMEOUT_MS=8000
VISIONOPS_TUBE_POLL_INTERVAL_MS=50

# 运行日志
VISIONOPS_TUBE_LOG_LEVEL=INFO
