# VisionOps carton tube check configuration
# 任务：PLC/上位机 Modbus-TCP 触发 -> HP60C RGB+Depth 取图 -> C++ OBB -> row_median 高度判断 -> OK/NG 寄存器输出

VISIONOPS_CARTON_TUBE_ENABLE=1

# -----------------------------
# Modbus-TCP service
# -----------------------------
# 默认仍为 1503，用于单任务调试；正式和机器人同事对接建议运行 ../vision_robot_protocol_modbus_tcp.py，默认端口 5045。
VISIONOPS_CARTON_TUBE_MODBUS_HOST=0.0.0.0
VISIONOPS_CARTON_TUBE_MODBUS_PORT=1503
VISIONOPS_CARTON_TUBE_MODBUS_UNIT_ID=1

# 1 = 忽略 TCP Unit ID，兼容上位机使用 0/1/255
# 0 = 严格使用 VISIONOPS_CARTON_TUBE_MODBUS_UNIT_ID
VISIONOPS_CARTON_TUBE_MODBUS_SINGLE_SLAVE=1

VISIONOPS_CARTON_TUBE_ADDRESS_BASE=0
# 通讯表使用到 0~199，至少需要 200 个保持寄存器。
VISIONOPS_CARTON_TUBE_REGISTER_COUNT=200
VISIONOPS_CARTON_TUBE_POLL_INTERVAL_MS=50

# -----------------------------
# RGB / depth / OBB infer URLs
# -----------------------------
VISIONOPS_CARTON_TUBE_SNAPSHOT_URL=http://127.0.0.1:18182/stream/snapshot.jpg
VISIONOPS_CARTON_TUBE_DEPTH_URL=http://127.0.0.1:18182/stream/depth.png
VISIONOPS_CARTON_TUBE_DEPTH_META_URL=http://127.0.0.1:18181/stream/depth_meta
VISIONOPS_CARTON_TUBE_INFER_URL=http://127.0.0.1:8090/api/cpp/infer
VISIONOPS_CARTON_TUBE_HTTP_TIMEOUT_MS=5000

# -----------------------------
# Class mapping. Keep this consistent with your OBB model YAML.
# -----------------------------
VISIONOPS_CARTON_TUBE_STAND_CLASS_IDS=0
VISIONOPS_CARTON_TUBE_LYING_CLASS_IDS=1
VISIONOPS_CARTON_TUBE_STAND_NAMES=stand
VISIONOPS_CARTON_TUBE_LYING_NAMES=lying
VISIONOPS_CARTON_TUBE_MIN_CONF=0.30

# 满格是 5 x 8 = 40。统一服务下，触发 1/2/3 分别检查左四列/右四列/全部区域。
# 左四列和右四列理论数量都是 5x4=20，全部区域理论数量是 5x8=40。
# 若现场调试时暂时不希望“少放”直接 NG，可临时把对应值改小。
VISIONOPS_CARTON_TUBE_MIN_STAND_COUNT=1
VISIONOPS_CARTON_TUBE_MIN_STAND_COUNT_LEFT=20
VISIONOPS_CARTON_TUBE_MIN_STAND_COUNT_RIGHT=20
VISIONOPS_CARTON_TUBE_MIN_STAND_COUNT_ALL=40

# -----------------------------
# Stage2 depth parameters
# -----------------------------
# HP60C depth0/image_raw 是 16UC1；bridge 输出的 depth.png 仍保存 mm 深度值。
VISIONOPS_CARTON_TUBE_DEPTH_ROI_RADIUS_PX=12
VISIONOPS_CARTON_TUBE_DEPTH_PERCENTILE=50
VISIONOPS_CARTON_TUBE_MIN_VALID_DEPTH_PIXELS=30
VISIONOPS_CARTON_TUBE_MIN_DEPTH_MM=100
VISIONOPS_CARTON_TUBE_MAX_DEPTH_MM=3000

# Baseline mode:
#   row_median            : 按行中位数比较，推荐用于斜拍安装
#   current_frame_median  : 全局中位数，不推荐斜拍
#   fixed_env             : 使用 VISIONOPS_CARTON_TUBE_NORMAL_DEPTH_MM 固定全局基准
VISIONOPS_CARTON_TUBE_BASELINE_MODE=row_median

# 纸箱槽位布局：5 行 x 8 列 = 40 个槽位
VISIONOPS_CARTON_TUBE_EXPECTED_ROWS=5
VISIONOPS_CARTON_TUBE_EXPECTED_COLS=8

# 纸筒槽位编号顺序：
#   row_major = 从左到右、从上到下
#   col_major = 从上到下、从左到右
VISIONOPS_CARTON_TUBE_SLOT_ORDER=col_major

# 左四列/右四列区域，列号为 0-based：0~3 为左四列，4~7 为右四列。
VISIONOPS_CARTON_TUBE_LEFT_COL_START=0
VISIONOPS_CARTON_TUBE_LEFT_COL_END=3
VISIONOPS_CARTON_TUBE_RIGHT_COL_START=4
VISIONOPS_CARTON_TUBE_RIGHT_COL_END=7

# 左/右区域实际判断优先按图像 x 坐标分界。0 表示自动使用图像宽度一半，例如 640 图像默认 x=320。
# 如果现场纸箱不在图像正中，可改成实际分界线像素，例如 315。
VISIONOPS_CARTON_TUBE_REGION_SPLIT_X=0

# Used when BASELINE_MODE=fixed_env. If <=0, fixed baseline is invalid.
VISIONOPS_CARTON_TUBE_NORMAL_DEPTH_MM=0

# A tube is regarded as too high when row_baseline_depth - current_depth > threshold.
VISIONOPS_CARTON_TUBE_HEIGHT_THRESHOLD_MM=35

# Debug output. Each trigger saves latest rgb/depth/infer/result here.
VISIONOPS_CARTON_TUBE_SAVE_EVERY_TRIGGER=1
VISIONOPS_CARTON_TUBE_SAVE_RESULT_DIR=/tmp/carton_tube_check_latest

VISIONOPS_CARTON_TUBE_LOG_LEVEL=INFO

# Expected tube model used by the original web-controlled inference service.
VISIONOPS_CARTON_TUBE_EXPECTED_MODEL=/opt/visionops/models/rk3576-001_tube_new_obb_20260609_181148.rknn
VISIONOPS_CARTON_TUBE_EXPECTED_MODEL_YAML=/opt/visionops/models/rk3576-001_tube_new_obb_20260609_181148.yaml
