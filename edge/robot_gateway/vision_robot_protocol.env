# VisionOps unified Robot/PLC Modbus-TCP protocol service
# 对接《与视觉通讯内容定义表.xlsx》：
# Robot/PLC -> Vision: 写 101/102/103 触发
# Vision -> Robot/PLC: 写 1/2/3 结果，20~99 写纸隔板 40 个小方格中心点坐标

VISIONOPS_ROBOT_PROTOCOL_ENABLE=1

# -----------------------------
# Modbus-TCP service
# -----------------------------
VISIONOPS_ROBOT_PROTOCOL_MODBUS_HOST=0.0.0.0
VISIONOPS_ROBOT_PROTOCOL_MODBUS_PORT=5045
VISIONOPS_ROBOT_PROTOCOL_MODBUS_UNIT_ID=1

# 1 = 忽略 TCP Unit ID，兼容上位机使用 0/1/255
# 0 = 严格使用 VISIONOPS_ROBOT_PROTOCOL_MODBUS_UNIT_ID
VISIONOPS_ROBOT_PROTOCOL_MODBUS_SINGLE_SLAVE=1

# 通讯表里的地址按 0 基 offset 使用：0,1,2,...,199
VISIONOPS_ROBOT_PROTOCOL_ADDRESS_BASE=0

# 通讯表定义到 199，至少要 200 个寄存器。建议保持 200 或更大。
VISIONOPS_ROBOT_PROTOCOL_REGISTER_COUNT=200
VISIONOPS_ROBOT_PROTOCOL_POLL_INTERVAL_MS=50

# -----------------------------
# Debug output
# 每次触发保存对应任务最新 rgb/depth/infer/result/overlay。
# -----------------------------
VISIONOPS_ROBOT_PROTOCOL_SAVE_EVERY_TRIGGER=1
VISIONOPS_ROBOT_PROTOCOL_SAVE_RESULT_ROOT=/tmp/vision_robot_protocol_latest

VISIONOPS_ROBOT_PROTOCOL_LOG_LEVEL=INFO
