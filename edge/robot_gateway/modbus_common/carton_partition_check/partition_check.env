# VisionOps carton partition cell-structure check configuration
# 任务：PLC/上位机 Modbus-TCP 触发 -> HP60C RGB 取图 -> C++ YOLO 小方格检测 -> 5x8 模板结构判断 -> OK/NG

VISIONOPS_PARTITION_ENABLE=1

# -----------------------------
# Modbus-TCP service
# -----------------------------
# 默认 1504，避免和 tube_station(1502)、carton_tube_check(1503) 冲突。
VISIONOPS_PARTITION_MODBUS_HOST=0.0.0.0
VISIONOPS_PARTITION_MODBUS_PORT=1504
VISIONOPS_PARTITION_MODBUS_UNIT_ID=1
VISIONOPS_PARTITION_ADDRESS_BASE=0
VISIONOPS_PARTITION_REGISTER_COUNT=128
VISIONOPS_PARTITION_POLL_INTERVAL_MS=50

# -----------------------------
# RGB snapshot / C++ infer URLs
# 保持和现有 HP60C bridge、C++ 推理接口一致，不改接口。
# -----------------------------
VISIONOPS_PARTITION_SNAPSHOT_URL=http://127.0.0.1:18181/stream/snapshot.jpg
VISIONOPS_PARTITION_INFER_URL=http://127.0.0.1:8090/api/cpp/infer
VISIONOPS_PARTITION_HTTP_TIMEOUT_MS=5000

# -----------------------------
# Cell detection class mapping
# 你的纸格检测模型如果只有一个类别，通常 class_id=0 即可。
# -----------------------------
VISIONOPS_PARTITION_CELL_CLASS_IDS=0
VISIONOPS_PARTITION_CELL_CLASS_NAMES=cell,paper_cell
VISIONOPS_PARTITION_MIN_CONF=0.25
VISIONOPS_PARTITION_NMS_IOU=0.60

# -----------------------------
# Grid layout
# 当前正常隔板：5 行 x 8 列 = 40 个小方格。
# -----------------------------
VISIONOPS_PARTITION_EXPECTED_ROWS=5
VISIONOPS_PARTITION_EXPECTED_COLS=8
VISIONOPS_PARTITION_EXPECTED_COUNT=40
VISIONOPS_PARTITION_STRICT_COUNT=1

# 正常模板路径。第一次用正常图运行 --calibrate 后会生成该文件。
VISIONOPS_PARTITION_TEMPLATE_PATH=/opt/visionops/edge/robot_gateway/carton_partition_check/partition_template.json

# -----------------------------
# Template matching thresholds
# 建议先采集 30~100 张正常图统计后再收紧阈值。
# -----------------------------
# 这几个全局阈值先保持宽松，避免正常波动导致误判。
VISIONOPS_PARTITION_MAX_MEAN_CENTER_ERR_PX=22
VISIONOPS_PARTITION_MAX_P95_CENTER_ERR_PX=38

# v0.2 新增：用于识别“数量仍为40，但整体/边缘已经倾斜”的情况。
# 当前倾斜样例的 max_row_angle_diff≈3.95、row_angle_std_diff≈0.77、edge_cell_max_error≈22.2。
# 因此先只收紧这些更有区分度的指标；如需关闭某项，可设为 0 或负数。
VISIONOPS_PARTITION_MAX_CENTER_ERR_PX=24
VISIONOPS_PARTITION_MAX_EDGE_CELL_ERR_PX=20
VISIONOPS_PARTITION_MAX_ROW_ANGLE_DIFF_MAX_DEG=3.5
VISIONOPS_PARTITION_MAX_ROW_ANGLE_STD_DIFF_DEG=0.70

VISIONOPS_PARTITION_MAX_GRID_CENTER_OFFSET_PX=35
VISIONOPS_PARTITION_MAX_ROW_ANGLE_DIFF_DEG=5
VISIONOPS_PARTITION_MAX_COL_ANGLE_DIFF_DEG=5
VISIONOPS_PARTITION_MAX_AFFINE_ROT_DEG=5
VISIONOPS_PARTITION_MAX_AFFINE_SHEAR=0.18

# 框大小只作为辅助项。初期建议关闭，避免不同位置框大小差异导致误判。
VISIONOPS_PARTITION_ENABLE_SIZE_CHECK=0
VISIONOPS_PARTITION_MIN_BOX_SIZE_RATIO=0.55
VISIONOPS_PARTITION_MAX_BOX_SIZE_RATIO=1.80
VISIONOPS_PARTITION_MAX_BAD_SIZE_COUNT=6

# Debug output. 每次触发保存最新 rgb/infer/result/overlay。
VISIONOPS_PARTITION_SAVE_EVERY_TRIGGER=1
VISIONOPS_PARTITION_SAVE_RESULT_DIR=/tmp/carton_partition_check_latest

VISIONOPS_PARTITION_LOG_LEVEL=INFO
